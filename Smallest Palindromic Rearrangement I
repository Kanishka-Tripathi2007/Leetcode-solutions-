class Solution {
public:
    string smallestPalindrome(string s) {
        vector<int> freq(26, 0);

        // Count frequency of each character
        for (char c : s) {
            freq[c - 'a']++;
        }

        string left = "";
        char middle = '\0';

        // Build the left half using characters in sorted order
        for (int i = 0; i < 26; i++) {
            if (freq[i] % 2 == 1) {
                middle = char('a' + i);
            }

            left += string(freq[i] / 2, char('a' + i));
        }

        // Create the right half by reversing the left half
        string right = left;
        reverse(right.begin(), right.end());

        // Combine left + middle + right
        if (middle != '\0') {
            return left + middle + right;
        }

        return left + right;
    }
};
