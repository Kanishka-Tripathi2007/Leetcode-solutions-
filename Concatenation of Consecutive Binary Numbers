class Solution {
public:
    int concatenatedBinary(int n) {
        const long long MOD = 1e9 + 7;
        long long ans = 0;

        for (int i = 1; i <= n; i++) {
            // Number of bits in i
            int len = 32 - __builtin_clz(i);

            // Append binary representation of i
            ans = (ans * (1LL << len) + i) % MOD;
        }

        return ans;
    }
};
